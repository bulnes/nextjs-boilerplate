# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Nenhuma conexão real é necessária para rodar o boilerplate localmente (FR-028).
# Todas as variáveis abaixo são exclusivamente server-side (sem prefixo NEXT_PUBLIC_):
# não há client Supabase de browser neste boilerplate, apenas Server/Route Handlers e o
# refresh de sessão em proxy.ts.

# Painel do projeto Supabase > Project Settings > API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anonima-aqui"

# NUNCA exponha esta chave ao client (FR-027). Uso restrito a Server Actions/Route Handlers.
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"

# String de conexão usada pelo Drizzle ORM — tanto offline (migrations/seed)
# quanto em runtime pelos Route Handlers (ver db/client.ts). Este papel do
# Postgres não passa pelo Row Level Security; a autorização nesse caminho é
# feita em código de aplicação (ver README.md > Banco de dados).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
